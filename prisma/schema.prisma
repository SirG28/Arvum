// Schema completo das 12 entidades do domínio (Context.md secao 17).
// Apenas User, Property e MachineCategory possuem services/API/UI na Etapa 1 (Fundacao);
// as demais tabelas existem no banco mas ficam vazias ate a Fase 2+.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum DocumentType {
  CPF
  CNPJ
}

enum MachineCondition {
  NEW
  EXCELLENT
  GOOD
  FAIR
  NEEDS_MAINTENANCE
}

enum MachineStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  UNAVAILABLE
  PAUSED
  REJECTED
  ARCHIVED
}

enum MachineAvailabilityType {
  MANUAL_BLOCK
  BOOKING_HOLD
  BOOKING_CONFIRMED
}

enum BookingStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  AWAITING_PAYMENT
  PAYMENT_CONFIRMED
  TRANSPORT_SCHEDULED
  IN_TRANSIT
  DELIVERED
  IN_USE
  AWAITING_RETURN
  RETURNED
  COMPLETED
  CANCELLED
  IN_DISPUTE
}

enum LogisticsMode {
  RENTER_PICKUP
  OWNER_DELIVERY
  PARTNER_TRANSPORT
}

enum LogisticsQuoteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  APPROVED
  REFUSED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REPORTED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
}

model User {
  id                      String        @id @default(cuid())
  name                    String
  email                   String        @unique
  passwordHash            String
  phone                   String?
  documentType            DocumentType?
  documentNumber          String?       @unique
  avatarUrl               String?
  // Texto curto de apresentação exibido no perfil (público e próprio) — puramente descritivo, sem
  // regra de negócio associada (Context.md não define nada específico sobre isso).
  bio                     String?
  role                    UserRole      @default(USER)
  status                  UserStatus    @default(ACTIVE)
  // Registro de aceite dos termos (Context.md §19) — preenchido no cadastro, quando
  // acceptedTerms já é obrigatório; nunca reescrito depois (é um carimbo do momento do aceite).
  termsAcceptedAt         DateTime?
  // Preferência de notificação por e-mail (Context.md §8.16) — guardada desde já para o futuro
  // sistema de envio respeitar, mesmo sem nenhum e-mail sendo disparado ainda.
  notifyByEmail           Boolean       @default(true)
  // Pedido de exclusão de dados (LGPD, Context.md §19 "mecanismo de solicitação de exclusão") —
  // registra a intenção; a exclusão em si depende de triagem humana (retenção financeira/legal),
  // por isso não é uma exclusão automática.
  dataDeletionRequestedAt DateTime?
  // Troca de e-mail (Context.md §8.1 "validação básica de e-mail"): sem provedor de envio
  // configurado, o token de confirmação é devolvido direto na resposta da API e a interface simula
  // o clique no link (mesmo padrão de adaptador simulado do restante do projeto — Context.md §27).
  // O e-mail só muda de fato quando pendingEmailToken é confirmado.
  pendingEmail            String?
  pendingEmailToken       String?
  pendingEmailExpiresAt   DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  deletedAt               DateTime?

  properties           Property[]
  machines             Machine[]
  bookingsAsRenter     Booking[]              @relation("BookingRenter")
  bookingStatusChanges BookingStatusHistory[]
  reviewsAuthored      Review[]               @relation("ReviewAuthor")
  reviewsReceived      Review[]               @relation("ReviewTarget")
  favorites            Favorite[]
  subscription         Subscription?

  @@index([status])
}

model Property {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  name        String
  addressLine String
  number      String?
  complement  String?
  district    String?
  city        String
  state       String
  postalCode  String
  latitude    Float?
  longitude   Float?
  accessNotes String?
  roadType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  machines              Machine[]
  bookingsAsDestination Booking[]

  @@index([ownerId])
  @@index([city, state])
}

model MachineCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  machines Machine[]
}

model Machine {
  id                        String           @id @default(cuid())
  ownerId                   String
  owner                     User             @relation(fields: [ownerId], references: [id])
  propertyId                String
  property                  Property         @relation(fields: [propertyId], references: [id])
  categoryId                String
  category                  MachineCategory  @relation(fields: [categoryId], references: [id])
  title                     String
  slug                      String           @unique
  brand                     String?
  model                     String?
  manufactureYear           Int?
  description               String
  purpose                   String?
  recommendedCrops          String[]         @default([])
  condition                 MachineCondition
  weight                    Float?
  width                     Float?
  height                    Float?
  length                    Float?
  requiresOperator          Boolean          @default(false)
  dailyPriceInCents         Int
  hourlyPriceInCents        Int?
  minimumPriceInCents       Int?
  depositInCents            Int?
  minimumRentalDays         Int              @default(1)
  maximumRentalDays         Int?
  instantBooking            Boolean          @default(false)
  deliveryRadiusKm          Float?
  deliveryPricePerKmInCents Int?
  deliveryBaseFeeInCents    Int?
  status                    MachineStatus    @default(DRAFT)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  deletedAt                 DateTime?

  images       MachineImage[]
  availability MachineAvailability[]
  bookings     Booking[]
  reviews      Review[]
  favorites    Favorite[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([status])
}

model MachineImage {
  id        String   @id @default(cuid())
  machineId String
  machine   Machine  @relation(fields: [machineId], references: [id])
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([machineId])
}

model MachineAvailability {
  id        String                  @id @default(cuid())
  machineId String
  machine   Machine                 @relation(fields: [machineId], references: [id])
  startDate DateTime
  endDate   DateTime
  type      MachineAvailabilityType
  reason    String?
  createdAt DateTime                @default(now())

  @@index([machineId, startDate, endDate])
}

model Booking {
  id                           String        @id @default(cuid())
  machineId                    String
  machine                      Machine       @relation(fields: [machineId], references: [id])
  renterId                     String
  renter                       User          @relation("BookingRenter", fields: [renterId], references: [id])
  destinationPropertyId        String
  destinationProperty          Property      @relation(fields: [destinationPropertyId], references: [id])
  startDate                    DateTime
  endDate                      DateTime
  status                       BookingStatus @default(DRAFT)
  rentalValueInCents           Int
  logisticsValueInCents        Int
  serviceFeeInCents            Int
  depositInCents               Int
  discountInCents              Int           @default(0)
  totalValueInCents            Int
  logisticsMode                LogisticsMode
  distanceKm                   Float?
  operationSupportIncluded     Boolean       @default(false)
  operationSupportValueInCents Int           @default(0)
  notes                        String?
  cancellationReason           String?
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt

  statusHistory   BookingStatusHistory[]
  logisticsQuotes LogisticsQuote[]
  payments        Payment[]
  reviews         Review[]

  @@index([machineId, startDate, endDate])
  @@index([renterId])
  @@index([status])
}

model BookingStatusHistory {
  id             String         @id @default(cuid())
  bookingId      String
  booking        Booking        @relation(fields: [bookingId], references: [id])
  previousStatus BookingStatus?
  nextStatus     BookingStatus
  changedById    String
  changedBy      User           @relation(fields: [changedById], references: [id])
  notes          String?
  createdAt      DateTime       @default(now())

  @@index([bookingId])
}

model LogisticsQuote {
  id                    String               @id @default(cuid())
  bookingId             String
  booking               Booking              @relation(fields: [bookingId], references: [id])
  originPropertyId      String
  destinationPropertyId String
  mode                  LogisticsMode
  distanceKm            Float
  durationMinutes       Int?
  baseFeeInCents        Int
  pricePerKmInCents     Int
  equipmentFactor       Float
  totalInCents          Int
  status                LogisticsQuoteStatus @default(PENDING)
  expiresAt             DateTime?
  createdAt             DateTime             @default(now())

  @@index([bookingId])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String
  booking           Booking       @relation(fields: [bookingId], references: [id])
  provider          String        @default("simulado")
  externalReference String?
  amountInCents     Int
  status            PaymentStatus @default(PENDING)
  paymentMethod     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([bookingId])
  @@index([status])
}

model Review {
  id                     String       @id @default(cuid())
  bookingId              String
  booking                Booking      @relation(fields: [bookingId], references: [id])
  authorId               String
  author                 User         @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetUserId           String
  targetUser             User         @relation("ReviewTarget", fields: [targetUserId], references: [id])
  machineId              String
  machine                Machine      @relation(fields: [machineId], references: [id])
  rating                 Int
  machineConditionRating Int?
  communicationRating    Int?
  punctualityRating      Int?
  logisticsRating        Int?
  comment                String?
  status                 ReviewStatus @default(PUBLISHED)
  // Preenchido por quem denuncia (opcional); limpo quando a moderação decide (Fase 6) — não é um
  // histórico de denúncias, só o motivo da denúncia em aberto no momento.
  reportReason           String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@unique([bookingId, authorId])
  @@index([machineId])
  @@index([targetUserId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  machineId String
  machine   Machine  @relation(fields: [machineId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, machineId])
}

// Plano Premium para parceiros (Context.md §8.21/§9.7/§17) — um registro por proprietário, sempre
// reescrito ao assinar de novo (sem tabela de histórico de cobranças no MVP).
model Subscription {
  id               String             @id @default(cuid())
  ownerId          String             @unique
  owner            User               @relation(fields: [ownerId], references: [id])
  status           SubscriptionStatus @default(ACTIVE)
  priceInCents     Int
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime
  canceledAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}
