# Banco de dados (Postgres — ver docker-compose.yml para subir localmente)
DATABASE_URL="postgresql://arvum:arvum@localhost:5432/arvum?schema=public"
# Conexão direta (sem pooler) usada pelo Prisma Migrate. Em Postgres local, use o mesmo valor de
# DATABASE_URL; em provedores serverless com pooler (ex.: Neon), use a URL de conexão direta.
DIRECT_URL="postgresql://arvum:arvum@localhost:5432/arvum?schema=public"

# Auth.js — gere um valor com: npx auth secret
AUTH_SECRET="gere-um-valor-com-npx-auth-secret"

# Opcional em dev: o Next.js/Auth.js detecta host e porta automaticamente pela requisição.
# Defina apenas se for rodar atrás de um proxy ou em produção (ex.: URL pública do deploy).
# NEXTAUTH_URL="http://localhost:3000"

NODE_ENV="development"
